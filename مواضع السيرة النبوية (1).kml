			<latitude>24.54187931854023</latitude>
			<altitude>585.5792250323298</altitude>
			<heading>0</heading>
			<tilt>0</tilt>
			<gx:fovy>35</gx:fovy>
			<range>763.947813233608</range>
			<altitudeMode>absolute</altitudeMode>
		</LookAt>
