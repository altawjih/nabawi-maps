		<Point>
			<coordinates>39.61452140388909,24.47568068200652,601.8452347888165</coordinates>
		</Point>
	</Placemark>
	<Placemark id="01156707343FFBFAC5F4">
		<name>بقيع الغرقد</name>
		<description><![CDATA[<div>بقيع الغرقد هو المقبرة التاريخية الرئيسة في المدينة المنورة، وتقع إلى الجنوب الشرقي من المسجد النبوي. سُمّيت بهذا الاسم نسبة إلى شجر الغرقد الذي كان ينبت في الموقع قبل أن يُتخذ مقبرة لأهل المدينة.<br></div><div>يُعد البقيع من أهم المواقع الإسلامية؛ إذ دُفن فيه عدد كبير من الصحابة وأهل بيت النبي ﷺ والتابعين، مما أكسبه مكانة دينية وتاريخية كبيرة لدى المسلمين. شهد البقيع تطورات عمرانية متعددة في العهد السعودي من توسعات وترميمات وتسوير للمقبرة، وتمت توسعة المقبرة وتنظيمها وتطوير مرافقها، وإنشاء الأسوار والبوابات والممرات والخدمات المرتبطة بالدفن وتجهيز الجنائز.<br></div><div>للوصول إلى الموقع<br></div><div><a href="https://maps.app.goo.gl/RjH1P723ktHXtFaR9">https://maps.app.goo.gl/RjH1P723ktHXtFaR9</a><br></div>]]></description>
		<LookAt>
			<longitude>39.61402571651794</longitude>
			<latitude>24.46715302146991</latitude>
			<altitude>608.8564278322027</altitude>
			<heading>0</heading>
			<tilt>0</tilt>
			<gx:fovy>35</gx:fovy>
			<range>197.3738305319785</range>
			<altitudeMode>absolute</altitudeMode>
		</LookAt>
